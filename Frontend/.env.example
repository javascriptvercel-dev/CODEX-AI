# Optional OpenAI-compatible AI provider for the site assistant.
# Keep the real key server-side; do not prefix it with NEXT_PUBLIC_.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# Backend API origin. Set this for local development and deployment.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional server-only override for backend calls made by Next.js route handlers.
API_URL=
