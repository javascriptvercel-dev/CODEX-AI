# Optional OpenAI-compatible AI provider for the site assistant.
# Keep the real key server-side; do not prefix it with NEXT_PUBLIC_.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# Backend API origin used by browser requests and the short-link redirect.
# Local: http://localhost:4000
# Production: the public origin of your backend, e.g. https://api.example.com
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional server-only override for Next.js server-side backend requests.
# If set, use the same backend origin as NEXT_PUBLIC_API_URL.
API_URL=

# Backend deployment setting (set on the backend host, not in this frontend
# .env file): PUBLIC_FRONTEND_URL must be the public origin of this Next.js
# site, e.g. https://www.example.com. It is used to build short links such as
# https://www.example.com/s/AbCd1234. Also set backend FRONTEND_URL to that
# same origin for CORS and authentication redirects.
